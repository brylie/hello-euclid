{
    "default": true,
    "line-length": {
        "line_length": 120,
        "heading_line_length": 120,
        "code_blocks": false,
        "code_lines": false
    },
    "no-hard-tabs": true,
    "no-trailing-spaces": true,
    "no-multiple-blanks": true,
    "no-blanks-blockquote": false,
    "blanks-around-headings": true,
    "blanks-around-lists": true,
    "no-inline-html": false,
    "ul-indent": {
        "indent": 2
    },
    "list-marker-space": true,
    "list-indent": true,
    "code-block-style": {
        "style": "fenced"
    },
    "code-languages": true
}
